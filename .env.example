# ============================================================
# TBB-VaaniAI Configuration
# Copy this file to .env and modify as needed
# ============================================================

# --- LLM Configuration (The Brain) ---
# Point to any vLLM-compatible OpenAI API endpoint
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7
LLM_STREAMING=true

# --- STT Configuration (The Ears) ---
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=hi
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
STT_SERVER_HOST=0.0.0.0
STT_SERVER_PORT=8001

# --- TTS Configuration (The Voice) ---
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_VOICE=vaani_default.wav
XTTS_LANGUAGE=hi
XTTS_DEVICE=cuda
TTS_SERVER_HOST=0.0.0.0
TTS_SERVER_PORT=8002

# --- VAD Configuration ---
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=300
VAD_SPEECH_PAD_MS=100

# --- Pipeline Configuration ---
SENTENCE_CHUNK_MIN_WORDS=3
SENTENCE_CHUNK_MAX_WAIT_MS=500
FILLER_WORDS=Ji,Hmm,Achha,Dekhiye,Bilkul

# --- Orchestrator ---
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8080
LOG_LEVEL=INFO

# --- Audio Settings ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=30
